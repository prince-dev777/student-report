# ==========================================
# EDUTRAK SAAS - ENVIRONMENT VARIABLES
# ==========================================
# Instructions: Copy this file, rename it to '.env', and fill in your details.
# DO NOT commit the real '.env' file to GitHub.

# --- SERVER CONFIG ---
# Local testing: Use 5000. VPS/Production: Use 80 (for direct biometric connection)
PORT=5000
# Options: development, production
NODE_ENV=development

# --- MONGODB CONFIG ---
# Your MongoDB Atlas Connection String
MONGODB_URI=mongodb://your_username:your_password@cluster0.mongodb.net/test?ssl=true&retryWrites=true&w=majority
# Secret key for JWT tokens (Change this to a random long string for security)
JWT_SECRET=your_super_secret_jwt_key_here

# --- OMR SCANNING ---
# Path to python executable (Required if 'python' command is not recognized globally)
# E.g., /usr/bin/python3 on Ubuntu, or leave empty if default 'python' works
PYTHON_CMD=python3

# --- WHATSAPP INTEGRATION ---
# Options: 'ultramsg', 'twilio', or 'mock' (mock will just print to console)
WHATSAPP_PROVIDER=ultramsg

# Ultramsg Setup (If provider is ultramsg)
WHATSAPP_INSTANCE_ID=instance12345
WHATSAPP_TOKEN=your_ultramsg_token

# Twilio Setup (If provider is twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- SELF PING ---
# URL for the server to ping itself to stay awake (useful for Render, not needed for VPS)
SELF_PING_URL=http://localhost
